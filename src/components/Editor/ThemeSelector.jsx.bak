import React, { useContext } from 'react';
import { PageContext } from '../../context/PageContext';

const THEME_OPTIONS = [
  { id: 'minimalist', name: 'Minimaliste', preview: 'bg-gray-100 border-gray-300' },
  { id: 'pastel-gradient', name: 'Pastel Gradient', preview: 'bg-gradient-to-tr from-violet-300 via-pink-200 to-blue-300' },
  { id: 'cyberpunk', name: 'Cyberpunk', preview: 'bg-black border-yellow-400' },
  { id: 'sombre', name: 'Sombre', preview: 'bg-zinc-800 border-zinc-700' },
];

export default function ThemeSelector() {
  const { pageData, updateProfile } = useContext(PageContext);

  return (
    <div className="flex flex-col gap-4">
      <h2 className="text-lg font-semibold text-slate-800">Thème de la page</h2>
      
      <div className="grid grid-cols-2 gap-3">
        {THEME_OPTIONS.map((theme) => (
          <button
            key={theme.id}
            onClick={() => updateProfile({ theme: theme.id })}
            className={`flex items-center gap-3 p-3 rounded-xl border text-left transition-all ${
              pageData.theme === theme.id
                ? 'border-violet-600 bg-violet-50/50 ring-1 ring-violet-600'
                : 'border-slate-200 hover:bg-slate-50'
            }`}
          >
            {/* Petit rond d'aperçu de couleur */}
            <div className={`w-6 h-6 rounded-full border ${theme.preview}`} />
            <span className="text-sm font-medium text-slate-700">{theme.name}</span>
          </button>
        ))}
      </div>
    </div>
  );
}